msgstr "Favorites only"

msgid "Título"
msgstr "Title"

msgid "Autor"
msgstr "Author"

msgid "Formato"
msgstr "Format"

msgid "Estado"
msgstr "Status"

msgid "Categorías"
msgstr "Categories"

msgid "(Todas las categorías)"
msgstr "(All categories)"

msgid "{nombre} ({total} libro(s))"
msgstr "{nombre} ({total} book(s))"

msgid "Selecciona primero un género o subgénero para moverlo."
msgstr "Select a genre or subgenre first to move it."

msgid "{nombre} movido {direccion}."
msgstr "{nombre} moved {direccion}."

msgid "Ya está en ese extremo, no se puede mover más."
msgstr "Already at that end, it can't be moved further."

msgid "Categoría renombrada a {nombre}."
msgstr "Category renamed to {nombre}."

msgid "Ya existe una categoría con ese nombre en el mismo nivel."
msgstr "A category with that name already exists at the same level."

