# English translation of Epub TTS Accesible.
msgid ""
msgstr ""
"Project-Id-Version: Epub TTS Accesible 3.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: en\n"

msgid "Índice del libro cargado. Usa las flechas Arriba y Abajo para navegar por los capítulos. Pulsa Intro o Enter sobre un capítulo para saltar a él en el área de texto."
msgstr "Book index loaded. Use the Up and Down arrows to navigate chapters. Press Enter on a chapter to jump to it in the text area."

msgid "Libro"
msgstr "Book"

msgid "Área de texto de solo lectura con el contenido del capítulo activo. Puedes seleccionar texto y copiarlo. La voz TTS lee desde la posición del cursor."
msgstr "Read-only text area with the content of the active chapter. You can select text and copy it. The TTS voice reads from the cursor position."

msgid "¡Bienvenido a Epub TTS! Tu lector de EPUB y PDF con soporte para voces de alta calidad en la nube (Azure, Amazon Polly, Deepgram y ElevenLabs) y voces locales SAPI5. Pulsa Ctrl + O para abrir un libro, o usa Ctrl + 1 a Ctrl + 5 para moverte entre las pestañas. Recuerda marcar tus voces favoritas en Ajustes para empezar a leer. ¡Disfruta de la lectura!"
msgstr "Welcome to Epub TTS! Your EPUB and PDF reader with support for high-quality cloud voices (Azure, Amazon Polly, Deepgram and ElevenLabs) and local SAPI5 voices. Press Ctrl + O to open a book, or use Ctrl + 1 through Ctrl + 5 to move between tabs. Remember to mark your favorite voices in Settings to start reading. Enjoy!"

msgid "Progreso: {pct}%"
msgstr "Progress: {pct}%"

msgid "Barra de progreso de lectura"
msgstr "Reading progress bar"

msgid "Posición de lectura expresada en porcentaje del libro. Usa las flechas Izquierda y Derecha para navegar. Al soltar la tecla, la voz saltará a esa posición."
msgstr "Reading position expressed as a percentage of the book. Use the Left and Right arrows to navigate. When you release the key, the voice will jump to that position."

msgid "Voz para lectura:"
msgstr "Voice for reading:"

msgid "Selector de voz"
msgstr "Voice selector"

msgid "Voz con la que se leerá el libro. Contiene las voces favoritas marcadas en Ajustes y las voces SAPI5 locales instaladas en el sistema."
msgstr "Voice used to read the book. Contains the favorite voices marked in Settings and the local SAPI5 voices installed on the system."

msgid "Retroceder {s}s"
msgstr "Rewind {s}s"

msgid "Reproducir (Ctrl+P)"
msgstr "Play (Ctrl+P)"

msgid "Avanzar {s}s"
msgstr "Forward {s}s"

msgid "Detener (Ctrl+D)"
msgstr "Stop (Ctrl+D)"

msgid "Detener"
msgstr "Stop"

msgid "Velocidad de lectura:"
msgstr "Reading speed:"

msgid "Velocidad de lectura"
msgstr "Reading speed"

msgid "Velocidad de lectura de la voz. 0 es la más lenta, 100 la más rápida. Flechas: ±1. RePág/AvPág: ±5."
msgstr "Reading speed of the voice. 0 is the slowest, 100 the fastest. Arrows: ±1. Page Up/Page Down: ±5."

msgid "Volumen:"
msgstr "Volume:"

msgid "Volumen de lectura"
msgstr "Reading volume"

msgid "Volumen del audio de lectura. 0 es silencio, 100 es volumen máximo. Flechas: ±1. RePág/AvPág: ±5."
msgstr "Reading audio volume. 0 is silence, 100 is maximum volume. Arrows: ±1. Page Up/Page Down: ±5."

msgid "No hay voces disponibles"
msgstr "No voices available"

msgid "Pausar (Ctrl+P)"
msgstr "Pause (Ctrl+P)"

msgid "Texto o frase a buscar:"
msgstr "Text or phrase to search for:"

msgid "Buscar en el libro"
msgstr "Search in book"

msgid "No se ha encontrado el texto especificado en este libro."
msgstr "The specified text was not found in this book."

msgid "Búsqueda finalizada"
msgstr "Search finished"

msgid "Se encontraron {n} resultados:"
msgstr "{n} results found:"

msgid "Seleccionar resultado"
msgstr "Select result"

msgid "Abre un libro antes de usar esta función."
msgstr "Open a book before using this function."

msgid "Sin libro"
msgstr "No book"

msgid "Ir a página o porcentaje"
msgstr "Go to page or percentage"

msgid "Rellena uno de los tres campos para saltar a esa posición del libro. Deja los otros dos en blanco. Prioridad si rellenas varios: porcentaje, luego página del libro, luego página del capítulo."
msgstr "Fill in one of the three fields to jump to that position in the book. Leave the other two blank. Priority if you fill in several: percentage, then book page, then chapter page."

msgid "Página del capítulo (1–{total}):"
msgstr "Chapter page (1–{total}):"

msgid "Número de página dentro del capítulo activo. Ahora estás en la página {pag} de {total}. Deja vacío para ignorar."
msgstr "Page number within the active chapter. You are currently on page {pag} of {total}. Leave empty to ignore."

msgid "Página del libro (1–{total}):"
msgstr "Book page (1–{total}):"

msgid "Número de página dentro del libro completo. Ahora estás en la página {pag} de {total}. Deja vacío para ignorar."
msgstr "Page number within the whole book. You are currently on page {pag} of {total}. Leave empty to ignore."

msgid "Porcentaje del libro (0–100):"
msgstr "Book percentage (0–100):"

msgid "Posición como porcentaje del libro completo. Ahora estás al {pct}%. Deja vacío para ignorar."
msgstr "Position as a percentage of the whole book. You are currently at {pct}%. Leave empty to ignore."

msgid "(Rellena solo el campo que quieras usar y deja los demás vacíos.)"
msgstr "(Fill in only the field you want to use and leave the others empty.)"

msgid "Velocidad ({etiqueta}):"
msgstr "Speed ({etiqueta}):"

msgid "Velocidad de lectura en multiplicadores. 0.2× es la más lenta, 1.0× es la normal, 1.8× es la más rápida. Flechas: ±1. RePág/AvPág: ±5."
msgstr "Reading speed as multipliers. 0.2× is the slowest, 1.0× is normal, 1.8× is the fastest. Arrows: ±1. Page Up/Page Down: ±5."

msgid "(Muy lenta)"
msgstr "(Very slow)"

msgid "(Lenta)"
msgstr "(Slow)"

msgid "(Normal)"
msgstr "(Normal)"

msgid "(Máxima)"
msgstr "(Maximum)"

msgid "(Muy rápida)"
msgstr "(Very fast)"

msgid "(Rápida)"
msgstr "(Fast)"

msgid "Seleccionar libro"
msgstr "Select book"

msgid "Libros compatibles (*.epub;*.pdf)|*.epub;*.pdf|Archivos EPUB (*.epub)|*.epub|Archivos PDF (*.pdf)|*.pdf"
msgstr "Compatible books (*.epub;*.pdf)|*.epub;*.pdf|EPUB files (*.epub)|*.epub|PDF files (*.pdf)|*.pdf"

msgid "Se ha producido un error técnico al intentar procesar el libro.\n\nDetalle: {error}"
msgstr "A technical error occurred while trying to process the book.\n\nDetail: {error}"

msgid "Error al cargar el libro"
msgstr "Error loading book"

msgid "Página {pag_cap} de {total_cap} del capítulo. Página {pag_libro} de {total_libro} del libro."
msgstr "Page {pag_cap} of {total_cap} of the chapter. Page {pag_libro} of {total_libro} of the book."

msgid "Velocidad: {etiqueta}"
msgstr "Speed: {etiqueta}"

msgid "Categoría"
msgstr "Category"

msgid "Gestión de Proyectos — Epub TTS"
msgstr "Project Management — Epub TTS"

msgid "Proyectos:"
msgstr "Projects:"

msgid "Lista de proyectos en árbol. Flechas para navegar; cada elemento muestra el nombre, el estado y el nivel. Tab: ir al panel de detalle. F2: renombrar. Supr: eliminar. Ctrl+Arriba / Ctrl+Abajo: reordenar dentro del mismo nivel. Ctrl+X: cortar para mover. Ctrl+V: pegar como subproyecto del seleccionado o como raíz si no hay nada seleccionado. Escape cancela el corte. Ctrl+Intro: abrir la carpeta en el Explorador. Menú o Shift+F10: más opciones."
msgstr "Tree list of projects. Arrows to navigate; each item shows the name, status and level. Tab: go to the detail panel. F2: rename. Delete: delete. Ctrl+Up / Ctrl+Down: reorder within the same level. Ctrl+X: cut to move. Ctrl+V: paste as a subproject of the selected item, or as root if nothing is selected. Escape cancels the cut. Ctrl+Enter: open the folder in Explorer. Menu or Shift+F10: more options."

msgid "Nombre del proyecto:"
msgstr "Project name:"

msgid "Nombre del proyecto seleccionado. Escribe el nuevo nombre y pulsa Intro para guardar."
msgstr "Name of the selected project. Type the new name and press Enter to save."

msgid "Categorías del proyecto:"
msgstr "Project categories:"

msgid "Categorías del proyecto. Flechas para navegar, Espacio para marcar o desmarcar. Puedes seleccionar varias a la vez."
msgstr "Project categories. Arrows to navigate, Space to check or uncheck. You can select several at once."

msgid "Archivos TXT asociados:"
msgstr "Associated TXT files:"

msgid "Nombre del archivo"
msgstr "File name"

msgid "Ruta completa"
msgstr "Full path"

msgid "Archivos de texto vinculados a este proyecto. Flechas para navegar. Usa el botón Quitar TXT para desvincular el seleccionado."
msgstr "Text files linked to this project. Arrows to navigate. Use the Remove TXT button to unlink the selected one."

msgid "Añadir TXT…"
msgstr "Add TXT…"

msgid "Abre un explorador de archivos para seleccionar un archivo de texto y vincularlo al proyecto."
msgstr "Opens a file browser to select a text file and link it to the project."

msgid "Quitar TXT"
msgstr "Remove TXT"

msgid "Desvincula el archivo de texto seleccionado de este proyecto. El archivo en disco no se borra."
msgstr "Unlinks the selected text file from this project. The file on disk is not deleted."

msgid "Añadir TXT"
msgstr "Add TXT"

msgid "Voces asignadas:"
msgstr "Assigned voices:"

msgid "Etiqueta"
msgstr "Tag"

msgid "Voz asignada"
msgstr "Assigned voice"

msgid "Voces asignadas a las etiquetas del proyecto. Si no hay voces propias, se muestran las heredadas del proyecto padre."
msgstr "Voices assigned to the project's tags. If there are no own voices, the ones inherited from the parent project are shown."

msgid "Eliminar proyecto"
msgstr "Delete project"

msgid "Elimina el proyecto seleccionado y todos sus subproyectos. Se pedirá confirmación antes de proceder. También puedes pulsar Supr desde el árbol."
msgstr "Deletes the selected project and all its subprojects. Confirmation will be requested before proceeding. You can also press Delete from the tree."

msgid "Cerrar"
msgstr "Close"

msgid "Cierra el gestor y devuelve el foco a la ventana principal. También puedes pulsar Escape."
msgstr "Closes the manager and returns focus to the main window. You can also press Escape."

msgid "Resultado de la última acción realizada."
msgstr "Result of the last action performed."

msgid "Proyectos"
msgstr "Projects"

msgid "«{nombre}» no está asociado a ningún proyecto. Abre el menú contextual para asociarlo."
msgstr "“{nombre}” is not associated with any project. Open the context menu to associate it."

msgid "Archivo asociado al proyecto: {nombre}"
msgstr "File associated with the project: {nombre}"

msgid "proyecto"
msgstr "project"

msgid "Corte cancelado. «{nombre}» permanece en su sitio."
msgstr "Cut cancelled. “{nombre}” remains in place."

msgid "El nombre no puede estar vacío."
msgstr "The name cannot be empty."

msgid "Nombre no válido"
msgstr "Invalid name"

msgid "Nuevo proyecto"
msgstr "New project"

msgid "Nuevo subproyecto dentro del seleccionado"
msgstr "New subproject inside the selected one"

msgid "Asociar TXT actual de Grabación"
msgstr "Associate current Recording TXT"

msgid "Pegar como subproyecto (Ctrl+V)"
msgstr "Paste as subproject (Ctrl+V)"

msgid "Pegar como raíz (Ctrl+V)"
msgstr "Paste as root (Ctrl+V)"

msgid "Cortar (Ctrl+X)"
msgstr "Cut (Ctrl+X)"

msgid "Mover arriba (Ctrl+Arriba)"
msgstr "Move up (Ctrl+Up)"

msgid "Mover abajo (Ctrl+Abajo)"
msgstr "Move down (Ctrl+Down)"

msgid "Renombrar (F2)"
msgstr "Rename (F2)"

msgid "Eliminar…\tSupr"
msgstr "Delete…\tDel"

msgid "Vaciar papelera…"
msgstr "Empty trash…"

msgid "No hay proyectos eliminados recientemente"
msgstr "No recently deleted projects"

msgid "Restaurar proyectos eliminados recientemente…"
msgstr "Restore recently deleted projects…"

msgid "«{archivo}» asociado a «{proyecto}»."
msgstr "“{archivo}” associated with “{proyecto}”."

msgid "«{nombre}» cortado. Navega al destino y pulsa Ctrl+V para pegar, o Escape para cancelar."
msgstr "“{nombre}” cut. Navigate to the destination and press Ctrl+V to paste, or Escape to cancel."

msgid "{nombre} cortado"
msgstr "{nombre} cut"

msgid "No hay ningún proyecto cortado. Selecciona uno y pulsa Ctrl+X."
msgstr "No project has been cut. Select one and press Ctrl+X."

msgid "«{nombre}» pegado como subproyecto de «{destino}»."
msgstr "“{nombre}” pasted as a subproject of “{destino}”."

msgid "{nombre} movido a {destino}"
msgstr "{nombre} moved to {destino}"

msgid "«{nombre}» movido a raíz."
msgstr "“{nombre}” moved to root."

msgid "{nombre} movido a raíz"
msgstr "{nombre} moved to root"

msgid "No puedes pegar un proyecto dentro de sí mismo."
msgstr "You cannot paste a project inside itself."

msgid "No se puede pegar aquí: causaría un ciclo en la jerarquía."
msgstr "Cannot paste here: it would create a cycle in the hierarchy."

msgid "arriba"
msgstr "up"

msgid "abajo"
msgstr "down"

msgid "Movido {direccion}: {nombre}"
msgstr "Moved {direccion}: {nombre}"

msgid "{nombre} movido {direccion}"
msgstr "{nombre} moved {direccion}"

msgid "No se puede mover: está en el límite o es un proyecto raíz."
msgstr "Cannot move: it is at the boundary or is a root project."

msgid "No se puede mover"
msgstr "Cannot move"

msgid "Nombre guardado: {nombre}"
msgstr "Name saved: {nombre}"

msgid "Selecciona primero un proyecto."
msgstr "Select a project first."

msgid "Sin selección"
msgstr "No selection"

msgid "Seleccionar archivo TXT para asociar al proyecto"
msgstr "Select TXT file to associate with the project"

msgid "Archivos de texto (*.txt)|*.txt|Todos (*.*)|*.*"
msgstr "Text files (*.txt)|*.txt|All (*.*)|*.*"

msgid "Selecciona primero un archivo en la lista para quitarlo."
msgstr "First select a file in the list to remove it."

msgid "Escribe el nombre del nuevo proyecto. Campo obligatorio."
msgstr "Type the name of the new project. This field is required."

msgid "Categorías (puedes elegir varias):"
msgstr "Categories (you can choose several):"

msgid "Categorías del proyecto. Usa las flechas para moverte y Espacio para marcar o desmarcar. Puedes asignar varias categorías al mismo tiempo."
msgstr "Project categories. Use the arrows to move and Space to check or uncheck. You can assign several categories at once."

msgid "Crear proyecto"
msgstr "Create project"

msgid "Cancelar"
msgstr "Cancel"

msgid "Nuevo proyecto raíz"
msgstr "New root project"

msgid "Proyecto «{nombre}» creado."
msgstr "Project “{nombre}” created."

msgid "Selecciona primero el proyecto padre en la lista."
msgstr "First select the parent project in the list."

msgid "Nuevo subproyecto de «{padre}»"
msgstr "New subproject of “{padre}”"

msgid "Subproyecto «{nombre}» creado dentro de «{padre}»."
msgstr "Subproject “{nombre}” created inside “{padre}”."

msgid "Proyecto restaurado correctamente."
msgstr "Project restored successfully."

msgid "No se encontró el proyecto en la papelera."
msgstr "The project was not found in the trash."

msgid "Error al restaurar"
msgstr "Restore error"

msgid "¿Eliminar definitivamente {n} proyecto(s) de la papelera?\n\nEsta acción no se puede deshacer."
msgstr "Permanently delete {n} project(s) from the trash?\n\nThis action cannot be undone."

msgid "Vaciar papelera"
msgstr "Empty trash"

msgid "Papelera vaciada."
msgstr "Trash emptied."

msgid "Selecciona un proyecto en la lista para eliminarlo."
msgstr "Select a project in the list to delete it."

msgid "¿Eliminar «{nombre}» y todos sus subproyectos?\n\nPuedes recuperarlos después desde el menú contextual."
msgstr "Delete “{nombre}” and all its subprojects?\n\nYou can recover them later from the context menu."

msgid "¿Eliminar el proyecto «{nombre}»?\n\nPuedes recuperarlo después desde el menú contextual."
msgstr "Delete the project “{nombre}”?\n\nYou can recover it later from the context menu."

msgid "Confirmar eliminación"
msgstr "Confirm deletion"

msgid "No se pudo eliminar el proyecto:\n{error}"
msgstr "The project could not be deleted:\n{error}"

msgid "Error al eliminar"
msgstr "Delete error"

msgid "Grabado"
msgstr "Recorded"

msgid "Pendiente"
msgstr "Pending"

msgid "Sin categoría"
msgstr "No category"

msgid "{nombre} [{tipo}] — {estado} — Nivel {nivel}"
msgstr "{nombre} [{tipo}] — {estado} — Level {nivel}"

msgid " — Subproyecto de: {padre}"
msgstr " — Subproject of: {padre}"

msgid "No se pudo crear la carpeta: {error}"
msgstr "The folder could not be created: {error}"

msgid "Abriendo carpeta: {nombre}"
msgstr "Opening folder: {nombre}"

msgid "No se pudo abrir la carpeta: {error}"
msgstr "The folder could not be opened: {error}"

msgid "Gestión de Proyectos — {mensaje}"
msgstr "Project Management — {mensaje}"

msgid "Nueva versión disponible: {version}"
msgstr "New version available: {version}"

msgid "Hay una nueva versión disponible: {version}\n¿Deseas instalarla ahora?"
msgstr "A new version is available: {version}\nDo you want to install it now?"

msgid "Se ha detectado una versión más reciente en el repositorio de GitHub. Pulsa Sí para actualizar o No para cerrar sin actualizar."
msgstr "A newer version has been detected in the GitHub repository. Press Yes to update or No to close without updating."

msgid "No se pudo cargar el texto de novedades desde el repositorio.\nVisita GitHub para ver los cambios de esta versión."
msgstr "The changelog text could not be loaded from the repository.\nVisit GitHub to see the changes in this version."

msgid "Novedades de la versión. Solo lectura. Usa las flechas, RePág y AvPág para desplazarte."
msgstr "Version changelog. Read-only. Use the arrows, Page Up and Page Down to scroll."

msgid "&Sí, actualizar ahora"
msgstr "&Yes, update now"

msgid "Descarga e instala la nueva versión. Tus configuraciones y grabaciones no se borrarán. La aplicación se cerrará y se volverá a abrir automáticamente."
msgstr "Downloads and installs the new version. Your settings and recordings will not be deleted. The application will close and reopen automatically."

msgid "&No, cerrar"
msgstr "&No, close"

msgid "Cierra este diálogo sin actualizar. Podrás actualizar más tarde desde Ajustes."
msgstr "Closes this dialog without updating. You can update later from Settings."

msgid "No, cerrar"
msgstr "No, close"

msgid "Nueva categoría"
msgstr "New category"

msgid "Nombre de la nueva categoría:"
msgstr "Name of the new category:"

msgid "Crear como subcategoría de «{nombre}»"
msgstr "Create as subcategory of “{nombre}”"

msgid "Crear como subcategoría (selecciona antes una categoría en el árbol)"
msgstr "Create as subcategory (select a category in the tree first)"

msgid "Escribe un nombre para la categoría."
msgstr "Enter a name for the category."

msgid "Nombre vacío"
msgstr "Empty name"

msgid "Importar carpeta... (Ctrl+O)"
msgstr "Import folder... (Ctrl+O)"

msgid "Importar carpeta"
msgstr "Import folder"

msgid "Importar libro..."
msgstr "Import book..."

msgid "Añade un único archivo EPUB o PDF a la Biblioteca, sin escanear toda una carpeta."
msgstr "Adds a single EPUB or PDF file to the Library, without scanning an entire folder."

msgid "Importar libro"
msgstr "Import book"

msgid "Árbol de géneros y subgéneros. Flechas para navegar; seleccionar un nodo filtra la lista de libros por esa categoría (incluye subgéneros). F2 renombra, Supr elimina, Ctrl+X/Ctrl+V mueve un género bajo otro, Ctrl+Arriba/Ctrl+Abajo lo reordena entre sus hermanos, Menú o Shift+F10 para más opciones."
msgstr "Tree of genres and subgenres. Arrows to navigate; selecting a node filters the book list by that category (including subgenres). F2 renames, Del deletes, Ctrl+X/Ctrl+V moves a genre under another, Ctrl+Up/Ctrl+Down reorders it among its siblings, Menu or Shift+F10 for more options."

msgid "Nueva categoría... (F2 renombra, Supr elimina)"
msgstr "New category... (F2 renames, Del deletes)"

msgid "Géneros"
msgstr "Genres"

msgid "Lista plana de etiquetas (sagas y colecciones personalizadas). Seleccionar una filtra la lista de libros por esa etiqueta. F2 renombra, Supr elimina."
msgstr "Flat list of tags (sagas and custom collections). Selecting one filters the book list by that tag. F2 renames, Del deletes."

msgid "Nueva etiqueta... (F2 renombra, Supr elimina)"
msgstr "New tag... (F2 renames, Del deletes)"

msgid "Sagas y colecciones"
msgstr "Sagas and collections"

msgid "Buscar por título o autor (Ctrl+F):"
msgstr "Search by title or author (Ctrl+F):"

msgid "Estado:"
msgstr "Status:"

