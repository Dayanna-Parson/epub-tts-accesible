msgstr "Select a tag first to rename it."

msgid "Nuevo nombre de la etiqueta:"
msgstr "New tag name:"

msgid "Renombrar etiqueta"
msgstr "Rename tag"

msgid "Etiqueta renombrada a {nombre}."
msgstr "Tag renamed to {nombre}."

msgid "Ya existe una etiqueta con ese nombre."
msgstr "A tag with that name already exists."

msgid "¿Eliminar la etiqueta «{nombre}»?\n\nLos libros no se eliminan, solo dejan de tener esta etiqueta."
msgstr "Delete the tag “{nombre}”?\n\nBooks are not deleted, they just stop having this tag."

msgid "Eliminar etiqueta"
msgstr "Delete tag"

msgid "Etiqueta {nombre} eliminada."
msgstr "Tag {nombre} deleted."

msgid "Nombre de la nueva etiqueta:"
msgstr "Name of the new tag:"

